{
  "name": "mobile-payments-sdk-react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme MobilePaymentsSdkReactNativeExample --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\""
  },
  "dependencies": {
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bouncy-checkbox": "^4.1.4",
    "react-native-build-config": "^0.3.2",
    "react-native-permissions": "^5.6.3",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.1",
    "react-native-uuid": "^2.0.3",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react-native-vector-icons": "^6.4.18",
    "patch-package": "^8.0.0",
    "react-native-builder-bob": "^0.30.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@3.6.1"
}
